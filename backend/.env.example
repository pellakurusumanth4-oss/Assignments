# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection for the mock CRM (tables auto-created + seeded from data/*.json on first run).
# Create the DB once:  sudo -u postgres psql -c "CREATE ROLE refund_app LOGIN PASSWORD 'refund_app';" \
#                                            -c "CREATE DATABASE refund_agent OWNER refund_app;"
DATABASE_URL=postgresql+psycopg://refund_app:refund_app@localhost:5432/refund_agent

# Optional: route through an Anthropic-compatible gateway (e.g. TokenRouter). The Anthropic
# SDK reads this automatically and appends /v1/messages, so do NOT include /v1 in the URL.
# ANTHROPIC_BASE_URL=https://api.tokenrouter.com

# Optional: override the models (defaults shown). The agent uses AGENT_MODEL and fails over to FALLBACK_MODEL.
# AGENT_MODEL=claude-sonnet-4-6
# FALLBACK_MODEL=claude-haiku-4-5

# Optional: LangSmith tracing. With these set, every agent run (model + tool calls, tokens, latency,
# failover/retry) is traced to LangSmith automatically — zero code. The admin panel shows an
# "Open in LangSmith" link. No-op if unset — the in-app SSE reasoning dashboard always works regardless.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=acme-refund-agent

# Optional: voice bonus (ElevenLabs). Set the key to enable the mic button + spoken replies.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL    # default "Sarah"
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1

# Optional: deterministically inject a failure on the next turn (for the resilience demo).
# Prefer arming these live from the admin dashboard instead.
# CHAOS_MODEL_ERROR=1
# CHAOS_INVALID_DECISION=1
